# ML backend (FastAPI) base URL called by Next.js API routes
# Inside Docker Compose use the service name: http://ml:8001
# For local non-Docker dev: http://127.0.0.1:8001
ML_API_URL=http://ml:8001

# Gemini API Configuration for DIY ideas
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
